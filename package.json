{
  "name": "realestate",
  "version": "1.0.0",
  "description": "API للتجارة الإلكترونية مع نظام إدارة المتاجر والمنتجات",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "dev:watch": "nodemon --watch . --ext js,json app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:create": "mysql -u root -p -e \"CREATE DATABASE IF NOT EXISTS souq;\"",
    "db:reset": "mysql -u root -p -e \"DROP DATABASE IF EXISTS souq; CREATE DATABASE souq;\"",
    "db:sync": "node -e \"require('./models').sequelize.sync({force: false}).then(() => process.exit(0))\"",
    "db:sync:force": "node -e \"require('./models').sequelize.sync({force: true}).then(() => process.exit(0))\"",
    "lint": "echo \"Linting not configured yet\"",
    "clean": "rm -rf node_modules package-lock.json && npm install"
  },
  "keywords": [
    "ecommerce",
    "api",
    "nodejs",
    "express",
    "sequelize",
    "mysql",
    "realestate"
  ],
  "author": "Your Name",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.14.3",
    "sequelize": "^6.37.7",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "nodemonConfig": {
    "ignore": [
      "uploads/*",
      "node_modules/*",
      "*.test.js"
    ],
    "delay": "1000"
  }
}